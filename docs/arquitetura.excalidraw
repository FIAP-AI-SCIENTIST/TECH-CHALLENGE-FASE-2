    {
      "type": "text", "id": "batch_ev_txt",
      "x": 472, "y": 428, "width": 700, "height": 122,
      "text": "extract_incremental(\"uf\")\n  SELECT * FROM basedosdados.br_inep_avaliacao_alfabetizacao.uf\n  WHERE ano > 2023\n\n  clear_partition(\"uf\", \"ano=2024\")        1x por (entidade, ano)\n  write_partition(..., part_id=\"0\")   ->   bronze/uf/ano=2024/part-0.parquet\n  write_partition(..., part_id=\"1\")   ->   bronze/uf/ano=2024/part-1.parquet",
      "originalText": "extract_incremental(\"uf\")\n  SELECT * FROM basedosdados.br_inep_avaliacao_alfabetizacao.uf\n  WHERE ano > 2023\n\n  clear_partition(\"uf\", \"ano=2024\")        1x por (entidade, ano)\n  write_partition(..., part_id=\"0\")   ->   bronze/uf/ano=2024/part-0.parquet\n  write_partition(..., part_id=\"1\")   ->   bronze/uf/ano=2024/part-1.parquet",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
