# Substitua pelos valores da sua conta Google Cloud
project_id      = "seu-projeto-gcp"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
alert_email     = "seu-email@exemplo.com"

bq_location     = "US"           # Multi-region: MANDATÓRIO para bater com 'basedosdados'
gcs_location    = "us-central1"  # Regional: Constituinte da multi-region US (melhor custo)

