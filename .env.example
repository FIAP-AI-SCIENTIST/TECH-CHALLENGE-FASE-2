# Modelo de arquivo de configuração de ambiente local
# Copie este arquivo para .env e preencha com seus dados reais:
# cp .env.example .env
#
# Para carregar no terminal antes de usar o Terraform ou a pipeline:
# source .env

# --- Projeto GCP -------------------------------------------------------------
# Um único valor configura o Terraform e a pipeline Python: o código lê
# TF_VAR_project_id como alias de GCP_PROJECT_ID, então não é preciso repetir.
export TF_VAR_project_id="seu-projeto-gcp"

# --- Terraform ---------------------------------------------------------------
export TF_VAR_billing_account="SEU-ID-DE-FATURAMENTO-GCP"
export TF_VAR_alert_email="seu-email@exemplo.com"
export TF_VAR_bq_location="US"
export TF_VAR_gcs_location="us-central1"
export TF_VAR_region="us-central1"
# Mapa e-mail -> papel: "roles/viewer" (só ver) ou "roles/editor" (sobe/destrói a
# infra — ganha automaticamente resourcemanager.projectIamAdmin + billing.costsManager)
export TF_VAR_team_members='{ "colega@gmail.com" = "roles/editor" }'

# --- Pipeline (opcionais) ----------------------------------------------------
# Todos têm default coerente com o que o Terraform provisiona. Descomente só se
# o seu ambiente divergir da convenção.
#
# Projeto GCP sob o nome canônico, caso prefira não depender do alias TF_VAR_:
# export GCP_PROJECT_ID="seu-projeto-gcp"
#
# Dataset BigQuery da Gold, auditoria e Data Quality.
# export GCP_DATASET_ID="alfabetizacao_analytics"
#
# Bucket do data lake. Default: "${TF_VAR_project_id}-datalake", que é como o
# Terraform o nomeia em infra/modules/storage/main.tf. Só defina se divergir.
# export GCP_BUCKET_NAME="seu-projeto-gcp-datalake"
#
# Dataset público da Base dos Dados lido pela extração batch.
# export GCP_SOURCE_DATASET="basedosdados.br_inep_avaliacao_alfabetizacao"
#
# Tópico e subscription do caminho de streaming.
# export PUBSUB_TOPIC="alfabetizacao-streaming-events"
# export PUBSUB_SUBSCRIPTION="alfabetizacao-streaming-consumer-sub"
